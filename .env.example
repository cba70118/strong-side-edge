# Copy this file to .env and fill in real values.
#   .env is gitignored. .env.example is committed. Never put a real key here.
#
#   powershell:  Copy-Item .env.example .env

# --- The Odds API ---------------------------------------------------------
# https://the-odds-api.com/  free 500 credits/mo | $30 = 20k | $59 = 100k
# Credits per call = [markets] x [regions]. Historical calls cost 10x.
THE_ODDS_API_KEY=

# --- SportsGameOdds (optional) --------------------------------------------
# https://sportsgameodds.com/  $99/mo, 80+ books INCLUDING Pinnacle.
# Only needed for the sharp CLV-grading anchor; The Odds API has no Pinnacle.
# Leave blank until we decide the free tier is too thin.
SPORTSGAMEODDS_API_KEY=

# --- Behaviour ------------------------------------------------------------
# Regions and books to request. us2 carries several newer US books.
ODDS_API_REGIONS=us,us2
# Guard rail: refuse to run a pull that would burn more than this many credits.
ODDS_API_MAX_CREDITS_PER_RUN=500
